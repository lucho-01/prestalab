rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Función auxiliar para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }

    // Reglas para salas y laboratorios
    match /salas/{salaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Reglas para catálogo de artículos e inventario localizado
    match /articulos/{articleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Reglas para solicitudes dinámicas de préstamo
    match /solicitudes/{solId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Reglas para préstamos (compatibilidad con app móvil)
    match /prestamos/{loanId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Reglas para usuarios y roles RBAC
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
