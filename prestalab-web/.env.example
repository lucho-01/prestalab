# Servidor web (Next.js) — proyecto prestalab-f2436
# Copiar a .env.local

# --- Firebase Admin SDK (servidor) ---
FIREBASE_PROJECT_ID=prestalab-f2436
FIREBASE_CLIENT_EMAIL=
# Pega el valor de "private_key" del JSON de la cuenta de servicio,
# con los saltos de línea escapados como \n.
# Alternativa recomendada: guarda el JSON como serviceAccountKey.json.
FIREBASE_PRIVATE_KEY=

# --- Firebase Auth (login y registro) ---
# API key pública del proyecto (Configuración del proyecto -> Tus apps -> Web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=prestalab-f2436.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=prestalab-f2436
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_APP_NAME=PrestaLab

# --- Sesión de la app móvil (JWT propio) ---
# Cadena aleatoria larga (mínimo 16 caracteres). Debe ser la misma en Vercel.
AUTH_SECRET=
